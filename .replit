modules = ["nodejs-24"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["corepack", "pnpm@10.34.5", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "CUT Development"

[[workflows.workflow]]
name = "CUT Development"
mode = "parallel"
author = 61899471

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=8080 corepack pnpm@10.34.5 --filter @workspace/api-server run dev"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=22203 corepack pnpm@10.34.5 --filter @workspace/cut-os run dev"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["github:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[nix]
channel = "stable-25_05"

[[ports]]
localPort = 22203
